# =============================================================================
# AI Agents Workshop (IBM TechXchange edition) — Environment Variables
# =============================================================================
# You don't need to edit this file. scripts/install.sh runs
# scripts/ibm_cloud_login.py, which copies this file to .env and fills in the
# values below from the IBM Cloud API key you paste. Re-run that script to
# change your key:
#   uv run python scripts/ibm_cloud_login.py

# --- IBM watsonx Orchestrate (your agent) ------------------------------------
# WXO_API_KEY: your IBM Cloud API key.
# WXO_INSTANCE_URL: the workshop's watsonx Orchestrate instance (found from your key).
# WXO_NAME_PREFIX: prefix for your agent, tool, and connection names, so attendees
#                  sharing one Orchestrate instance don't overwrite each other.
#                  Set from your username.
# WXO_AGENT_NAME: optional; defaults to <WXO_NAME_PREFIX>lakeview_inbox_agent.
# WXO_API_KEY=your-ibm-cloud-api-key-here
# WXO_INSTANCE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
# WXO_NAME_PREFIX=student0_

# --- Shared workshop EHR (patient data) --------------------------------------
# EHR_API_URL: the shared EHR in the cloud. Your local inbox and your agent's
#              tools both read your private copy of the patients from it.
# EHR_TENANT: which copy is yours: a one-way fingerprint of your API key.
# EHR_API_URL=https://workshop-ehr.<project>.<region>.codeengine.appdomain.cloud
# EHR_TENANT=<set by scripts/ibm_cloud_login.py>

# --- Local ports (only if 8000 / 8501 / 8001 are taken) ----------------------
# API_PORT=8000
# AGENT_API_URL=http://localhost:8001
